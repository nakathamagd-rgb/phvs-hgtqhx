    ui.grid.appendChild(b);
  }
}

function newPlayer(){return{x:W()/2,y:H()-80,r:15,fireT:0,inv:0,tilt:0,vx:0};}

/* ===== رسم المركبة ===== */
function drawShip(x,y,tilt,moving,inv){
  hoverT+=0.016;
  const bob=Math.sin(hoverT*3)*2;
  y+=bob;
  ctx.save();ctx.translate(x,y);ctx.rotate(tilt);
  if(inv>0&&Math.floor(hoverT*14)%2===0)ctx.globalAlpha=.4;

  /* لهب المحركين */
  const fl=(moving?30:17)+Math.sin(hoverT*30)*5;
  for(const s of[-8,8]){
    let g=ctx.createLinearGradient(s,13,s,13+fl);
    g.addColorStop(0,"rgba(255,255,255,.95)");
    g.addColorStop(.3,COL.player);
    g.addColorStop(1,"rgba(0,0,0,0)");
    ctx.fillStyle=g;
    ctx.beginPath();
    ctx.moveTo(s-4,13);ctx.quadraticCurveTo(s,13+fl,s+4,13);ctx.closePath();ctx.fill();
  }

  /* الجسم */
  let g=ctx.createLinearGradient(0,-24,0,14);
  g.addColorStop(0,"#ffffff");
  g.addColorStop(.4,COL.player);
  g.addColorStop(1,colorShade(COL.player,-70));
  ctx.fillStyle=g;
  ctx.beginPath();
  ctx.moveTo(0,-24);
  ctx.quadraticCurveTo(7,-8,7,2);
  ctx.lineTo(19,10);ctx.lineTo(17,14);ctx.lineTo(8,11);
  ctx.lineTo(0,14);
  ctx.lineTo(-8,11);ctx.lineTo(-17,14);ctx.lineTo(-19,10);
  ctx.lineTo(-7,2);
  ctx.quadraticCurveTo(-7,-8,0,-24);
  ctx.fill();
  ctx.strokeStyle="rgba(0,0,0,.55)";ctx.lineWidth=1.6;ctx.stroke();

  /* حواف الجناحين */
  ctx.strokeStyle=colorShade(COL.player,60);ctx.lineWidth=1.4;
  ctx.beginPath();ctx.moveTo(7,2);ctx.lineTo(19,10);ctx.moveTo(-7,2);ctx.lineTo(-19,10);ctx.stroke();

  /* العمود الفقري والمقصورة */
  ctx.strokeStyle="rgba(255,255,255,.5)";ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(0,-20);ctx.lineTo(0,8);ctx.stroke();
  g=ctx.createRadialGradient(0,-9,1,0,-9,6);
  g.addColorStop(0,"#fff");g.addColorStop(.55,COL.player);g.addColorStop(1,colorShade(COL.player,-45));
  ctx.fillStyle=g;
  ctx.beginPath();ctx.ellipse(0,-9,4,6.5,0,0,7);ctx.fill();
  ctx.fillStyle="rgba(0,0,0,.5)";
  ctx.fillRect(-11,10,5,3);ctx.fillRect(6,10,5,3);
  ctx.restore();
}
function colorShade(hex,amt){
  const n=parseInt(hex.slice(1),16);
  let r=(n>>16)+amt,g=((n>>8)&255)+amt,b=(n&255)+amt;
  r=Math.max(0,Math.min(255,r));g=Math.max(0,Math.min(255,g));b=Math.max(0,Math.min(255,b));
  return "#"+((r<<16)|(g<<8)|b).toString(16).padStart(6,"0");
}

/* ===== الصخور البلورية ===== */
function makeRock(x,y,r,vx,vy){
  const pts=[],n=8+Math.floor(Math.random()*4);
  for(let i=0;i<n;i++){const a=i/n*Math.PI*2,rr=r*(.72+Math.random()*.35);
    pts.push([Math.cos(a)*rr,Math.sin(a)*rr]);}
  const facets=[];
  for(let i=0;i<3;i++)facets.push([Math.random()*r*1.2-r*.6,Math.random()*r*1.2-r*.6]);
  return{x,y,r,vx,vy,rot:Math.random()*7,vr:(Math.random()-.5)*2,pts,facets,hp:r>34?4:r>22?2:1};
}
function drawRock(r){
  ctx.save();ctx.translate(r.x,r.y);ctx.rotate(r.rot);
  let g=ctx.createRadialGradient(-r.r*.3,-r.r*.3,2,0,0,r.r);
  g.addColorStop(0,"#8FA6C4");g.addColorStop(.55,"#51678C");g.addColorStop(1,"#232F4C");
  ctx.fillStyle=g;
  ctx.beginPath();
  r.pts.forEach((pt,idx)=>idx?ctx.lineTo(pt[0],pt[1]):ctx.moveTo(pt[0],pt[1]));
  ctx.closePath();ctx.fill();
  ctx.strokeStyle="#141E36";ctx.lineWidth=2;ctx.stroke();
  ctx.strokeStyle="rgba(255,255,255,.16)";ctx.lineWidth=1;
  for(const f of r.facets){
    ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(f[0],f[1]);ctx.stroke();
  }
  ctx.restore();
}

/* ===== الدرونات ===== */
function spawnDrone(){
  drones.push({x:60+Math.random()*(W()-120),y:-30,t:0,hp:3+Math.floor(level/3),
    fireT:1+Math.random()*1.5,r:16,drift:(Math.random()-.5)*60});
}
function drawDrone(d){
  ctx.save();ctx.translate(d.x,d.y);
  /* جناحان */
  const w=Math.sin(d.t*14)*.6;
  ctx.fillStyle=COL.drone;ctx.globalAlpha=.35;
  ctx.beginPath();ctx.ellipse(-13,-2,9,3.5,-.5+w,0,7);ctx.fill();
  ctx.beginPath();ctx.ellipse(13,-2,9,3.5,.5-w,0,7);ctx.fill();
  ctx.globalAlpha=1;
  /* الجسم */
  let g=ctx.createLinearGradient(0,-10,0,14);
  g.addColorStop(0,colorShade(COL.drone,50));g.addColorStop(1,colorShade(COL.drone,-60));
  ctx.fillStyle=g;
  ctx.beginPath();ctx.moveTo(0,14);ctx.lineTo(-11,-8);ctx.lineTo(0,-3);ctx.lineTo(11,-8);ctx.closePath();ctx.fill();
  ctx.strokeStyle="#fff";ctx.lineWidth=1.4;ctx.stroke();
  ctx.fillStyle="#fff";
  ctx.beginPath();ctx.arc(0,-4,2.4,0,7);ctx.fill();
  ctx.restore();
}

/* ===== الوحش ===== */
const BOSS_NAMES=["الوحش القرمزي","أم الأخطار","سيد الظلام","آخر الوحوش"];
function spawnBoss(){
  const tier=Math.ceil(level/5);
  boss={x:W()/2,y:-90,r:60+Math.min(tier*6,20),t:0,dir:1,fireT:1.4,
    hp:50+level*8,maxHp:50+level*8,tier,
    name:BOSS_NAMES[Math.min(tier-1,BOSS_NAMES.length-1)],
    wob:Math.random()*7};
  SFX.roar();
}
function drawBoss(b){
  const p=player;
  /* هالة خلفية */
  let g=ctx.createRadialGradient(b.x,b.y,b.r*.4,b.x,b.y,b.r*2);
  g.addColorStop(0,COL.boss+"22");g.addColorStop(1,"rgba(0,0,0,0)");
  ctx.fillStyle=g;ctx.beginPath();ctx.arc(b.x,b.y,b.r*2,0,7);ctx.fill();

  ctx.save();ctx.translate(b.x,b.y);ctx.rotate(Math.sin(b.t*3)*.06);
  ctx.strokeStyle=COL.boss;ctx.lineCap="round";
  for(let k=0;k<5;k++){
    const a=(k/5-.5)*2.4, baseR=b.r*.85;
    ctx.lineWidth=10-k;
    ctx.globalAlpha=.85;
    ctx.beginPath();
    ctx.moveTo(Math.sin(a)*baseR*.6,baseR*.5);
    ctx.quadraticCurveTo(
      Math.sin(a)*baseR+Math.sin(b.t*4+k*2)*14, baseR+22,
      Math.sin(a)*baseR*1.4+Math.sin(b.t*3+k)*22, baseR+40+Math.sin(b.t*2+k)*8);
    ctx.stroke();
  }
  ctx.globalAlpha=1;
  /* تاج الأشواك */
  ctx.fillStyle=colorShade(COL.boss,-40);
  for(let k=0;k<7;k++){
    const a=(k/7-.5)*2.6;
    ctx.save();ctx.rotate(a);
    ctx.beginPath();
    ctx.moveTo(-6,-b.r*.92);ctx.lineTo(0,-b.r*1.18);ctx.lineTo(6,-b.r*.92);
    ctx.closePath();ctx.fill();
    ctx.restore();
  }
  /* الرأس الماسي */
  const pr=b.r*(1+Math.sin(b.t*5)*.04);
  g=ctx.createRadialGradient(-pr*.3,-pr*.3,pr*.2,0,0,pr);
  g.addColorStop(0,colorShade(COL.boss,60));
  g.addColorStop(.6,COL.boss);
  g.addColorStop(1,colorShade(COL.boss,-55));
  ctx.fillStyle=g;
  ctx.beginPath();
  for(let i=0;i<=14;i++){const a=i/14*Math.PI*2;
    const rr=pr*(1+Math.sin(a*3+b.t*4)*.07);
    const x=Math.cos(a)*rr,y=Math.sin(a)*rr;
    i?ctx.lineTo(x,y):ctx.moveTo(x,y);}
  ctx.closePath();ctx.fill();
  ctx.strokeStyle="rgba(0,0,0,.5)";ctx.lineWidth=3;ctx.stroke();

  /* عينان تتبعان اللاعب */
  const la=Math.atan2(p.y-b.y,p.x-b.x);
  const ex=Math.cos(la)*4,ey=Math.sin(la)*3;
  for(const s of[-1,1]){
    ctx.fillStyle="#fff";
    ctx.beginPath();ctx.ellipse(s*pr*.36,-pr*.2,11,13,0,0,7);ctx.fill();
    ctx.fillStyle="#1a0505";
    ctx.beginPath();ctx.arc(s*pr*.36+ex,-pr*.2+ey,5.5,0,7);ctx.fill();
    ctx.fillStyle="rgba(255,255,255,.9)";
    ctx.beginPath();ctx.arc(s*pr*.36+ex-2,-pr*.2+ey-2,1.8,0,7);ctx.fill();
  }
  /* الفم والأنياب */
  ctx.fillStyle="#2a0808";
  ctx.beginPath();ctx.ellipse(0,pr*.35,pr*.42,pr*.22+Math.sin(b.t*6)*3,0,0,Math.PI);ctx.fill();
  ctx.fillStyle="#fff";
  for(const s of[-1,0,1]){
    ctx.beginPath();
    ctx.moveTo(s*pr*.3-6,pr*.3);ctx.lineTo(s*pr*.3,pr*.42);ctx.lineTo(s*pr*.3+6,pr*.3);ctx.fill();
  }
  ctx.restore();

  /* شريط الصحة */
  const bw=Math.min(W()-120,380);
  ctx.fillStyle="rgba(255,255,255,.14)";
  ctx.beginPath();ctx.roundRect(W()/2-bw/2,40,bw,9,4.5);ctx.fill();
  ctx.fillStyle=COL.boss;
  ctx.beginPath();ctx.roundRect(W()/2-bw/2,40,Math.max(bw*Math.max(0,b.hp/b.maxHp),9),9,4.5);ctx.fill();
  ctx.fillStyle=COL.paper;ctx.font="600 14px Changa, Tahoma";ctx.textAlign="center";
  ctx.fillText(b.name,W()/2,32);
}

const POWERS=[{k:"T",c:()=>COL.gold,txt:"ثلاثي"},{k:"S",c:()=>COL.player,txt:"درع"},{k:"W",c:()=>COL.drone,txt:"إبطاء"}];
function dropLoot(x,y,force){
  const roll=Math.random();
  if(roll<(force?1:.10)){
    const p=POWERS[Math.floor(Math.random()*POWERS.length)];
    pickups.push({x,y,vy:70,type:p.k,c:p.c(),txt:p.txt,t:0});
  }else if(roll<.55)
    pickups.push({x,y,vy:90,type:"d",c:COL.gold,txt:"+",t:0});
}
function drawPickup(k){
  ctx.save();ctx.translate(k.x,k.y);
  ctx.fillStyle=k.c;
  ctx.beginPath();
  for(let i=0;i<6;i++){const a=i/6*Math.PI*2-Math.PI/2;
    i?ctx.lineTo(Math.cos(a)*13,Math.sin(a)*13):ctx.moveTo(Math.cos(a)*13,Math.sin(a)*13);}
  ctx.closePath();ctx.fill();
  ctx.strokeStyle="#fff";ctx.lineWidth=2;ctx.stroke();
  ctx.fillStyle=COL.ink;ctx.font="800 13px Changa, Tahoma";ctx.textAlign="center";ctx.textBaseline="middle";
  ctx.fillText(k.type==="d"?"+":k.type,0,1);
  ctx.textBaseline="alphabetic";
  ctx.restore();
}

function burst(x,y,color,n,pow=1){
  if(REDUCED)n=Math.min(n,4);
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2,s=(40+Math.random()*160)*pow;
    parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:.4+Math.random()*.5,t:0,c:color,r:1+Math.random()*2.5});
  }
}
function pop(x,y,txt,c){pops.push({x,y,txt,c,t:0,life:.9});}

function levelConfig(n){
  const bossL=n%5===0;
  return{bossL,
    count:bossL?Math.floor(2+n*.5):Math.floor(6+n*2.2),
    interval:Math.max(.35,1.1-n*.045),
    droneChance:Math.min(.28+n*.02,.55)};
}
function startLevel(n){
  level=n;ui.level.textContent=n;
  const c=levelConfig(n);
  spawned=0;toSpawn=c.count;spawnT=.8;levelDone=false;
  banner(c.bossL?"☠ المرحلة "+n+" — الوحش قادم!":"المرحلة "+n);
  if(c.bossL)spawnBoss();
  tone(520,780,.15,"triangle",.12);
}
function banner(txt){
  ui.banner.textContent=txt;ui.banner.style.opacity=1;ui.banner.style.transition="none";
  requestAnimationFrame(()=>{ui.banner.style.transition="opacity 1.2s ease .9s";ui.banner.style.opacity=0;});
}

function fire(){
  const p=player,y=p.y-20;
  if(tripleT>0){
    bullets.push({x:p.x,y,vx:-130,vy:-640},{x:p.x,y,vx:130,vy:-640},{x:p.x,y,vx:0,vy:-660});
  }else bullets.push({x:p.x,y,vx:0,vy:-660});
  SFX.shoot();
}

function mult(){return Math.min(1+combo*.1,5);}
function killRock(r,i){
  rocks.splice(i,1);
  burst(r.x,r.y,"#9FB4D4",r.r>30?26:12,r.r>30?1.4:1);
  const pts=Math.round((10+r.r)*mult());
  score+=pts;combo++;comboT=2.5;
  pop(r.x,r.y,"+"+pts,COL.gold);
  r.r>30?SFX.bigBoom():SFX.boom();
  if(r.r>26)for(let k=0;k<2;k++)
    rocks.push(makeRock(r.x+(k?12:-12),r.y,r.r*.55,(k?90:-90)+Math.random()*40,r.vy*.9));
  dropLoot(r.x,r.y);
  if(settings.shake)shake=Math.min(shake+(r.r>30?8:3),14);
}
function damagePlayer(){
  if(player.inv>0)return;
  if(shieldOn){shieldOn=false;player.inv=1.2;SFX.hit();
    burst(player.x,player.y,COL.player,16);pop(player.x,player.y-30,"الدرع تصدّه!",COL.player);return;}
  lives--;renderLives();player.inv=2;combo=0;SFX.hit();
  if(settings.shake)shake=14;flash=.5;
  burst(player.x,player.y,COL.enemy,24);
  if(lives<=0)gameOver();
}
function renderLives(){
  ui.lives.innerHTML="";
  for(let i=0;i<3;i++){
    const s=document.createElement("span");
    s.className=i<lives?"shield":"empty";
    s.textContent=i<lives?"◆":"◇";ui.lives.appendChild(s);
  }
}
function gameOver(){
  state="over";SFX.lose();
  ui.final.textContent="النقاط: "+score;
  if(score>hiScore){hiScore=score;store("space-hi",hiScore);ui.best.textContent="🏆 رقم قياسي جديد!";}
  else ui.best.textContent="أفضل نتيجة: "+hiScore;
  ui.hi.textContent=hiScore;
  show(ui.over);
}
function completeLevel(){
  levelDone=true;state="done";SFX.win();
  cleared[level]=true;store("space-cleared",JSON.stringify(cleared));
  if(level+1>unlocked&&level<MAX_LEVELS){unlocked=level+1;store("space-unlocked",unlocked);}
  if(score>hiScore){hiScore=score;store("space-hi",hiScore);ui.hi.textContent=hiScore;}
  $("doneLv").textContent=" أكملت المرحلة "+level;
  $("doneScore").textContent="النقاط: "+score;
  $("nextBtn").textContent=level>=MAX_LEVELS?"أكملت الكل! 🏆":"المرحلة التالية ►";
  $("nextBtn").disabled=level>=MAX_LEVELS;
  show(ui.done);
}

function update(dt){
  const p=player;
  hoverT+=dt;
  if(slowT>0){slowT-=dt;timeScale=.45;}else timeScale=1;
  const dts=dt*timeScale;

  let dx=0;
  if(keys.ArrowLeft||keys.KeyA)dx-=1;
  if(keys.ArrowRight||keys.KeyD)dx+=1;
  if(touchX!==null){
    const t=touchX-cv.getBoundingClientRect().left-p.x;
    dx=Math.abs(t)>6?Math.sign(t):0;
  }
  p.vx+=(dx*380-p.vx)*12*dt;
  p.x=Math.max(20,Math.min(W()-20,p.x+p.vx*dt));
  p.tilt+=(Math.max(-1,Math.min(1,p.vx/380))*.35-p.tilt)*10*dt;

  if(!REDUCED&&Math.random()<.6)
    parts.push({x:p.x-p.tilt*20+(Math.random()-.5)*8,y:p.y+16,vx:(Math.random()-.5)*20,
      vy:120+Math.random()*60,life:.3+Math.random()*.25,t:0,c:COL.player,r:1+Math.random()*1.5});

  p.fireT-=dt;
  if((keys.Space||touchX!==null)&&p.fireT<=0){fire();p.fireT=tripleT>0?.14:.19;}
  if(tripleT>0)tripleT-=dt;
  if(p.inv>0)p.inv-=dt;
  if(comboT>0){comboT-=dt;if(comboT<=0)combo=0;}
  ui.combo.textContent=combo>2?"سلسلة ×"+combo+" (مضاعف "+mult().toFixed(1)+")":"";
  if(shake>0)shake=Math.max(0,shake-40*dt);
  if(flash>0)flash-=dt*2;

  for(const s of stars){s.y+=s.sp*dts;if(s.y>H()){s.y=-2;s.x=Math.random()*W();}}
  for(const nb of nebulae){nb.y+=nb.dy*dts;nb.x+=nb.dx*dts;
    if(nb.y-nb.r>H()){nb.y=-nb.r;nb.x=Math.random()*W();}}
  if(!REDUCED&&Math.random()<dts*.12)
    shoots.push({x:Math.random()*W(),y:-10,vx:-(60+Math.random()*80),vy:260+Math.random()*120,t:0,life:.7});
  for(let i=shoots.length-1;i>=0;i--){const sh=shoots[i];sh.t+=dt;sh.x+=sh.vx*dt;sh.y+=sh.vy*dt;
    if(sh.t>=sh.life)shoots.splice(i,1);}

  if(spawned<toSpawn){
    spawnT-=dts;
    if(spawnT<=0){
      const c=levelConfig(level);
      spawnT=c.interval;spawned++;
      if(!c.bossL&&level>=3&&Math.random()<c.droneChance)spawnDrone();
      else{const r=18+Math.random()*26,sp=60+level*9+Math.random()*40;
        rocks.push(makeRock(40+Math.random()*(W()-80),-r-10,r,(Math.random()-.5)*40,sp));}
    }
  }

  for(let i=bullets.length-1;i>=0;i--){
    const b=bullets[i];b.x+=b.vx*dts;b.y+=b.vy*dts;
    if(b.y<-20||b.x<-10||b.x>W()+10){bullets.splice(i,1);continue;}
    let hit=false;
    for(let j=rocks.length-1;j>=0;j--){
      const r=rocks[j];
      if((b.x-r.x)**2+(b.y-r.y)**2<r.r*r.r){
        r.hp--;hit=true;burst(b.x,b.y,"#FFE0A6",3,.5);
        if(r.hp<=0)killRock(r,j);else{SFX.hit();if(settings.shake)shake=Math.min(shake+1.5,10);}
        break;
      }
    }
    if(!hit&&boss&&(b.x-boss.x)**2+(b.y-boss.y)**2<boss.r*boss.r){
      boss.hp--;hit=true;burst(b.x,b.y,"#FFE0A6",4,.6);SFX.hit();
      if(settings.shake)shake=Math.min(shake+1.5,10);
      if(boss.hp<=0){
        const pts=Math.round(600*mult());score+=pts;
        pop(boss.x,boss.y,"+"+pts,COL.gold);
        burst(boss.x,boss.y,COL.boss,60,2);SFX.bigBoom();
        if(settings.shake)shake=18;
        dropLoot(boss.x,boss.y,true);dropLoot(boss.x-40,boss.y+10,true);
        boss=null;toSpawn=Math.max(0,spawned);
      }
    }
    if(!hit)for(let j=drones.length-1;j>=0;j--){
      const d=drones[j];
      if((b.x-d.x)**2+(b.y-d.y)**2<d.r*d.r){
        d.hp--;hit=true;burst(b.x,b.y,COL.drone,4,.5);SFX.hit();
        if(d.hp<=0){
          drones.splice(j,1);burst(d.x,d.y,COL.drone,16);
          const pts=Math.round(60*mult());score+=pts;combo++;comboT=2.5;
          pop(d.x,d.y,"+"+pts,COL.drone);SFX.boom();dropLoot(d.x,d.y);
        }
        break;
      }
    }
    if(hit)bullets.splice(i,1);
  }

  for(let i=rocks.length-1;i>=0;i--){
    const r=rocks[i];
    r.x+=r.vx*dts;r.y+=r.vy*dts;r.rot+=r.vr*dts;
    if((r.x<r.r&&r.vx<0)||(r.x>W()-r.r&&r.vx>0))r.vx*=-1;
    if(r.y>H()+r.r+10){rocks.splice(i,1);continue;}
    if((r.x-p.x)**2+(r.y-p.y)**2<(r.r+p.r)**2){killRock(r,i);damagePlayer();}
  }

  for(let i=drones.length-1;i>=0;i--){
    const d=drones[i];d.t+=dts;
    if(d.y<110)d.y+=90*dts;
    else d.x=Math.max(30,Math.min(W()-30,d.x+Math.sin(d.t*1.4)*80*dts+d.drift*dts*.2));
    d.fireT-=dts;
    if(d.fireT<=0&&d.y>0){
      d.fireT=1.4+Math.random()*1.2;
      const a=Math.atan2(p.y-d.y,p.x-d.x);
      ebullets.push({x:d.x,y:d.y,vx:Math.cos(a)*230,vy:Math.sin(a)*230});
      tone(320,140,.12,"square",.1);
    }
    if((d.x-p.x)**2+(d.y-p.y)**2<(d.r+p.r)**2){drones.splice(i,1);burst(d.x,d.y,COL.drone,16);damagePlayer();}
  }

  for(let i=ebullets.length-1;i>=0;i--){
    const b=ebullets[i];b.x+=b.vx*dts;b.y+=b.vy*dts;
    if(b.y>H()+20||b.y<-20||b.x<-20||b.x>W()+20){ebullets.splice(i,1);continue;}
    if((b.x-p.x)**2+(b.y-p.y)**2<(p.r+5)**2){ebullets.splice(i,1);damagePlayer();}
  }

  if(boss){
    boss.t+=dts;
    if(boss.y<120)boss.y+=55*dts;
    else{
      boss.x+=boss.dir*(70+level*3)*dts;
      if(boss.x<90)boss.dir=1;if(boss.x>W()-90)boss.dir=-1;
      boss.fireT-=dts;
      if(boss.fireT<=0){
        const ratio=boss.hp/boss.maxHp;
        boss.fireT=ratio<.4?.9:1.5;
        for(let k=-1;k<=1;k++)
          ebullets.push({x:boss.x,y:boss.y+boss.r*.5,vx:k*130,vy:240});
        tone(260,110,.15,"square",.12);
        if(ratio<.5&&Math.random()<.4)spawnDrone();
      }
    }
    if((boss.x-p.x)**2+(boss.y-p.y)**2<(boss.r+p.r)**2)damagePlayer();
  }

  for(let i=pickups.length-1;i>=0;i--){
    const k=pickups[i];k.t+=dt;k.y+=k.vy*dts;
    if(k.y>H()+20){pickups.splice(i,1);continue;}
    if((k.x-p.x)**2+(k.y-p.y)**2<(p.r+14)**2){
      pickups.splice(i,1);SFX.power();
      if(k.type==="T"){tripleT=8;pop(p.x,p.y-30,"ثلاثي الرصاص!",k.c);}
      else if(k.type==="S"){shieldOn=true;pop(p.x,p.y-30,"درع طاقة!",k.c);}
      else if(k.type==="W"){slowT=5;pop(p.x,p.y-30,"إبطاء الزمن!",k.c);}
      else{const pts=Math.round(25*mult());score+=pts;pop(k.x,k.y,"+"+pts,k.c);}
    }
  }

  for(let i=parts.length-1;i>=0;i--){
    const pt=parts[i];pt.t+=dts;pt.x+=pt.vx*dts;pt.y+=pt.vy*dts;
    if(pt.t>=pt.life)parts.splice(i,1);
  }
  for(let i=pops.length-1;i>=0;i--){
    const pp=pops[i];pp.t+=dt;pp.y-=22*dt;
    if(pp.t>=pp.life)pops.splice(i,1);
  }

  ui.score.textContent=score;

  if(spawned>=toSpawn&&rocks.length===0&&drones.length===0&&!boss&&!levelDone){
    completeLevel();
  }
}

function draw(){
  ctx.save();
  if(shake>0)ctx.translate((Math.random()-.5)*shake,(Math.random()-.5)*shake);

  ctx.fillStyle=COL.ink;ctx.fillRect(0,0,W(),H());

  /* السدم */
  for(const nb of nebulae){
    const g=ctx.createRadialGradient(nb.x,nb.y,0,nb.x,nb.y,nb.r);
    g.addColorStop(0,COL[nb.c]+"1E");g.addColorStop(1,"rgba(0,0,0,0)");
    ctx.fillStyle=g;ctx.beginPath();ctx.arc(nb.x,nb.y,nb.r,0,7);ctx.fill();
  }

  /* النجوم */
  for(let i=0;i<stars.length;i++){
    const s=stars[i];
    ctx.fillStyle=COL.paper;
    ctx.globalAlpha=s.a*(REDUCED?1:.78+.22*Math.sin(hoverT*2+s.ph));
    ctx.fillRect(s.x,s.y,s.r,s.r);
  }
  ctx.globalAlpha=1;

  /* الشهب */
  for(const sh of shoots){
    const g=ctx.createLinearGradient(sh.x,sh.y,sh.x-sh.vx*.14,sh.y-sh.vy*.14);
    g.addColorStop(0,"rgba(255,255,255,.85)");g.addColorStop(1,"rgba(255,255,255,0)");
    ctx.strokeStyle=g;ctx.lineWidth=1.6;ctx.lineCap="round";
    ctx.beginPath();ctx.moveTo(sh.x,sh.y);ctx.lineTo(sh.x-sh.vx*.14,sh.y-sh.vy*.14);ctx.stroke();
  }

  for(const pt of parts){
    ctx.fillStyle=pt.c;ctx.globalAlpha=1-pt.t/pt.life;
    ctx.beginPath();ctx.arc(pt.x,pt.y,pt.r,0,7);ctx.fill();
  }
  ctx.globalAlpha=1;

  for(const k of pickups)drawPickup(k);
  for(const r of rocks)drawRock(r);
  for(const d of drones)drawDrone(d);
  if(boss)drawBoss(boss);

  ctx.fillStyle=COL.gold;
  for(const b of bullets)ctx.fillRect(b.x-2,b.y-7,4,14);
  ctx.fillStyle=COL.enemy;
  for(const b of ebullets){ctx.beginPath();ctx.arc(b.x,b.y,4.5,0,7);ctx.fill();}

  if(state==="playing"||state==="paused"){
    drawShip(player.x,player.y,player.tilt,keys.ArrowLeft||keys.KeyD||keys.ArrowRight||keys.KeyA||touchX!==null,player.inv);
    if(shieldOn){
      ctx.strokeStyle=COL.player;ctx.lineWidth=2.5;ctx.globalAlpha=.6+Math.sin(hoverT*10)*.3;
      ctx.beginPath();ctx.arc(player.x,player.y,player.r+10,0,7);ctx.stroke();
      ctx.globalAlpha=1;
    }
  }

  for(const pp of pops){
    ctx.save();ctx.globalAlpha=1-pp.t/pp.life;
    ctx.fillStyle=pp.c;ctx.font="600 15px Changa, Tahoma";ctx.textAlign="center";
    ctx.fillText(pp.txt,pp.x,pp.y);
    ctx.restore();
  }

  if(flash>0){ctx.fillStyle=`rgba(255,80,80,${flash})`;ctx.fillRect(0,0,W(),H());}
  ctx.restore();
}

function loop(t){
  const dt=Math.min((t-tPrev)/1000,.1);
  tPrev=t;
  if(state==="playing")update(dt);
  draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(t=>{tPrev=t;requestAnimationFrame(loop);});

function clearEntities(){
  boss=null;bullets=[];rocks=[];drones=[];ebullets=[];pickups=[];parts=[];pops=[];shoots=[];
  shake=0;flash=0;timeScale=1;slowT=0;combo=0;comboT=0;tripleT=0;shieldOn=false;
}
function show(scr){
  [ui.menu,ui.levels,ui.set,ui.pause,ui.done,ui.over].forEach(s=>s.classList.add("hidden"));
  if(scr)scr.classList.remove("hidden");
  $("pauseBtn").classList.toggle("hidden",!(state==="playing"||state==="paused"));
}

function startGame(n){
  audioInit();
  clearEntities();
  state="playing";score=0;lives=3;
  player=newPlayer();
  renderLives();
  if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();
  show(null);
  startLevel(n);
}

function togglePause(){
  if(state==="playing"){state="paused";show(ui.pause);$("pauseBtn").textContent="▶";}
  else if(state==="paused"){state="playing";show(null);$("pauseBtn").textContent="⏸";}
}

/* ربط أزرار الواجهة */
$("startBtn").onclick=()=>startGame(unlocked);
$("levelsBtn").onclick=()=>{buildGrid();show(ui.levels);};
$("settingsBtn").onclick=()=>show(ui.set);
$("backMenu1").onclick=()=>show(ui.menu);
$("backMenu2").onclick=()=>show(ui.menu);
$("resumeBtn").onclick=()=>togglePause();
$("quitBtn").onclick=()=>{clearEntities();state="menu";show(ui.menu);};
$("nextBtn").onclick=()=>startGame(level+1);
$("mapBtn").onclick=()=>{buildGrid();show(ui.levels);};
$("mapBtn2").onclick=()=>{buildGrid();show(ui.levels);};
$("againBtn").onclick=()=>startGame(level);
$("retryBtn").onclick=()=>startGame(level);
$("menuBtn").onclick=()=>{clearEntities();state="menu";show(ui.menu);};

$("muteBtn").onclick=()=>{
  muted=!muted;settings.sound=!muted;saveSettings();
  $("muteBtn").textContent=muted?"🔇":"🔊";
};
$("pauseBtn").onclick=()=>togglePause();

$("togSound").onclick=()=>{
  settings.sound=!settings.sound;muted=!settings.sound;
  saveSettings();syncTogs();
  $("muteBtn").textContent=muted?"🔇":"🔊";
};
$("togShake").onclick=()=>{
  settings.shake=!settings.shake;saveSettings();syncTogs();
};
</script>
