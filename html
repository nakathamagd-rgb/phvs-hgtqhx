<script>
"use strict";
const cv=document.getElementById("cv"), ctx=cv.getContext("2d");
const W=()=>cv.clientWidth, H=()=>cv.clientHeight;
const REDUCED=matchMedia("(prefers-reduced-motion: reduce)").matches;
const MAX_LEVELS=20;

const THEMES=[
  {name:"ليل الصحراء", ink:"#0B0E1A",deep:"#181E38",player:"#FFC24B",enemy:"#FF5D73",gold:"#FFC24B",drone:"#9D8CFF",boss:"#FF6B4A",paper:"#E8EEFF",dim:"#8C96B8",panel:"#141936",line:"#2A3358"},
  {name:"سديم بنفسجي", ink:"#100A20",deep:"#231545",player:"#6EE7D8",enemy:"#FF5D9E",gold:"#FFD97A",drone:"#B69DFF",boss:"#FF7A5C",paper:"#EFF4FF",dim:"#9A8CC0",panel:"#1D1238",line:"#3A2A66"},
  {name:"غابة نيون", ink:"#08140E",deep:"#123324",player:"#9DFF8A",enemy:"#FF5C7A",gold:"#FFE66D",drone:"#74D3FF",boss:"#FF8C42",paper:"#ECFDF0",dim:"#8BBFA0",panel:"#10281C",line:"#245C40"},
  {name:"شفق قطبي", ink:"#041018",deep:"#0E2A3C",player:"#7AD9FF",enemy:"#FF6E5E",gold:"#FFE28A",drone:"#C58CFF",boss:"#FF9455",paper:"#E6F6FF",dim:"#7FA8BC",panel:"#0C202E",line:"#1E4A62"}
];
let themeIdx=0;
const COL={};
function applyTheme(i){
  themeIdx=i;
  const t=THEMES[i], r=document.documentElement.style;
  r.setProperty("--ink",t.ink); r.setProperty("--deep",t.deep);
  r.setProperty("--accent",t.player); r.setProperty("--coral",t.enemy);
  r.setProperty("--gold",t.gold); r.setProperty("--paper",t.paper);
  r.setProperty("--dim",t.dim); r.setProperty("--panel",t.panel);
  r.setProperty("--line",t.line);
  Object.assign(COL,{ink:t.ink,deep:t.deep,player:t.player,enemy:t.enemy,
    gold:t.gold,drone:t.drone,boss:t.boss});
  document.querySelectorAll(".swatch").forEach((s,j)=>s.classList.toggle("sel",j===i));
}

let AC=null,master=null,muted=false;
function audioInit(){
  if(AC){if(AC.state==="suspended")AC.resume();return;}
  AC=new (window.AudioContext||window.webkitAudioContext)();
  master=AC.createGain();master.gain.value=.5;master.connect(AC.destination);
}
function tone(f0,f1,dur,type,vol,delay=0){
  if(!AC||muted)return;
  const t=AC.currentTime+delay,o=AC.createOscillator(),g=AC.createGain();
  o.type=type;o.frequency.setValueAtTime(f0,t);
  o.frequency.exponentialRampToValueAtTime(Math.max(f1,1),t+dur);
  g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
  o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.02);
}
function noiseS(dur,vol){
  if(!AC||muted)return;
  const n=AC.sampleRate*dur,buf=AC.createBuffer(1,n,AC.sampleRate),d=buf.getChannelData(0);
  for(let i=0;i<n;i++)d[i]=(Math.random()*2-1)*(1-i/n);
  const s=AC.createBufferSource(),g=AC.createGain(),f=AC.createBiquadFilter();
  f.type="lowpass";f.frequency.value=900;g.gain.value=vol;
  s.buffer=buf;s.connect(f);f.connect(g);g.connect(master);s.start();
}
const SFX={
  shoot:()=>tone(760,240,.09,"square",.11),
  boom:()=>{noiseS(.3,.25);tone(140,40,.25,"sawtooth",.2);},
  bigBoom:()=>{noiseS(.6,.4);tone(90,30,.5,"sawtooth",.3);},
  hit:()=>tone(200,80,.12,"sawtooth",.18),
  pick:()=>{tone(660,660,.07,"sine",.18);tone(990,990,.1,"sine",.18,.07);},
  power:()=>{tone(440,880,.15,"triangle",.2);tone(660,1320,.2,"triangle",.15,.1);},
  win:()=>{tone(523,523,.12,"triangle",.2);tone(659,659,.12,"triangle",.2,.12);tone(784,784,.25,"triangle",.22,.24);},
  lose:()=>tone(300,60,.7,"sawtooth",.3),
  roar:()=>{tone(80,45,.8,"sawtooth",.35);noiseS(.7,.3);}
