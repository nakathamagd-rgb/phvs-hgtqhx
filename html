function syncTogs(){
  $("togSound").classList.toggle("on",settings.sound);
  $("togShake").classList.toggle("on",settings.shake);
}
function buildGrid(){
  ui.grid.innerHTML="";
  for(let n=1;n<=MAX_LEVELS;n++){
    const b=document.createElement("button");
    const bossL=n%5===0;
    b.className="lvbtn"+(bossL?" bossL":"")+(n<unlocked||cleared[n]?" done":"")+(n===unlocked?" current":"");
