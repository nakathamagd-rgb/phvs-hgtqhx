function initStars(){
  stars=[];
  for(let L=0;L<3;L++)for(let i=0;i<38;i++)
    stars.push({x:Math.random()*W(),y:Math.random()*H(),r:(L+1)*.6,sp:12+L*22,a:.22+L*.25,ph:Math.random()*7});
  nebulae=[];
  for(let i=0;i<3;i++)
    nebulae.push({x:Math.random()*W(),y:Math.random()*H(),r:180+Math.random()*160,
      dx:(Math.random()-.5)*4,dy:6+Math.random()*8,c:i%2?"drone":"boss"});
}
function resize(){
  const d=Math.min(devicePixelRatio||1,2);
  cv.width=cv.clientWidth*d;cv.height=cv.clientHeight*d;
  ctx.setTransform(d,0,0,d,0,0);initStars();
}
addEventListener("resize",resize);
resize(); /* ضبط أبعاد الكانفس فور التحميل */

const keys={};
addEventListener("keydown",e=>{
  keys[e.code]=true;
  if(e.code==="Space")e.preventDefault();
