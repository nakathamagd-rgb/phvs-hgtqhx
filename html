let hiScore=0, unlocked=1, cleared={};
const settings={sound:true,shake:true};
function store(k,v){try{window.storage&&window.storage.set(k,typeof v==="string"?v:String(v)).catch(()=>{});}catch(e){}}
(async()=>{
  await Promise.resolve(); /* يضمن تشغيل التهيئة بعد تعريف الواجهة بالكامل */
  try{
    if(window.storage){
      const h=await window.storage.get("space-hi").catch(()=>null);
      if(h&&h.value)hiScore=h.value|0;
      const u=await window.storage.get("space-unlocked").catch(()=>null);
      if(u&&u.value)unlocked=Math.max(1,u.value|0);
      const c=await window.storage.get("space-cleared").catch(()=>null);
      if(c&&c.value){try{cleared=JSON.parse(c.value);}catch(e){}}
      const s=await window.storage.get("space-settings").catch(()=>null);
      if(s&&s.value){try{Object.assign(settings,JSON.parse(s.value));}catch(e){}}
      const t=await window.storage.get("space-theme").catch(()=>null);
      if(t&&t.value!=null)themeIdx=Math.min(THEMES.length-1,t.value|0);
    }
  }catch(e){}
  muted=!settings.sound;
  ui.hi.textContent=hiScore;
  applyTheme(themeIdx); buildThemeSwatches(); syncTogs(); buildGrid();
})();
function saveSettings(){store("space-settings",JSON.stringify(settings));}

